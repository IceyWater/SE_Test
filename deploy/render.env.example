# Enter values in Render's Environment panel. Never commit real secrets.
APP_NAME="Graduate School Test"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-SERVICE.onrender.com
APP_KEY=
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=defaultdb
DB_USERNAME=
DB_PASSWORD=
# Add the Aiven CA certificate as Render secret file /etc/secrets/aiven-ca.pem.
MYSQL_ATTR_SSL_CA=/etc/secrets/aiven-ca.pem
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
MAIL_MAILER=log
DEFENSE_REMINDER_EMAILS=false
RUN_MIGRATIONS=true
# Upload persistence still needs cloud storage configuration before document tests.

# Optional hosted demo accounts: choose a private password of 16-128 characters.
HOSTED_DEMO_ENABLED=false
HOSTED_DEMO_PASSWORD=
